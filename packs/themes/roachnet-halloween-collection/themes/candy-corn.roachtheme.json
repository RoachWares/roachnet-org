      "background": "#FFF6E8",
      "backgroundRaised": "#FBEBD4",
      "panel": "#FFFFFF",
      "panelRaised": "#FFFBF3",
      "panelSoft": "#F5E6CF",
      "text": "#2A1A0E",
      "accent": "#B93C08",
      "accentSecondary": "#6B2FA0",
      "accentTertiary": "#875800",
      "accentInfo": "#1F6F8B"
